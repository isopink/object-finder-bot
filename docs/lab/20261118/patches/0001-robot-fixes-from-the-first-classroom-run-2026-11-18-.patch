-  timeout "${2:-5}" ros2 topic hz "$1" 2>/dev/null | awk '/average rate/ {r=$3} END {if (r) print r}'
+  timeout -s INT "${2:-5}" ros2 topic hz "$1" 2>/dev/null | awk '/average rate/ {r=$3} END {if (r) print r}'
 }
 
